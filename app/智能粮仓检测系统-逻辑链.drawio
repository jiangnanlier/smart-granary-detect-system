        </mxCell>
        <mxCell id="c2" value="② 实时功率计算 P = U × I&#10;负载电流 I = 0.10A 待机&#10;+ 0.15A 风扇 / 0.08A 蜂鸣器 / 0.05A LED 全亮" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
