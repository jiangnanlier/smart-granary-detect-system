        <mxCell id="note_voltage" value="可调档位电压传感器（拨码 3 档）&#10;模拟输出 0~3V，真实电压 = ADC × 2&#10;档位1：2.50V → 5.00V 安全 4.8~5.2V&#10;档位2：2.30V → 4.60V 欠压&#10;档位3：2.70V → 5.40V 过压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
